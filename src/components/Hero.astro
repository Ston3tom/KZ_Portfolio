---
import { site, withBase } from '../data/site';

const profileSrc = withBase('images/profile_picture.jpg');
---

<section id="home" class="relative min-h-[100svh] overflow-hidden" aria-label="Hero">
  <div class="absolute inset-0">
    <img
      src={profileSrc}
      alt={`${site.name}, fitness and travel content creator`}
      class="hero-image-enter h-full w-full object-cover object-[center_18%]"
      width="1200"
      height="1600"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-14 pt-28 md:justify-center md:px-8 md:pb-24 md:pt-32">
    <div class="max-w-3xl text-paper">
      <p class="hero-enter section-label text-paper/70">
        {site.tagline}
      </p>

      <h1 class="hero-enter hero-enter-delay-1 mt-5 font-display text-[clamp(2.75rem,9vw,6.75rem)] font-extrabold leading-[0.9] tracking-[-0.04em] text-balance">
        {site.name}
      </h1>

      <div
        class="hero-accent-line mt-6 h-px w-16 bg-pink md:w-24"
        aria-hidden="true"
      ></div>

      <p class="hero-enter hero-enter-delay-2 mt-6 max-w-md text-base leading-relaxed text-paper/80 md:text-lg">
        Strength, travel, and lifestyle content from {site.location.split(',')[0]} — authentic training and lived-in storytelling for brand collaborations.
      </p>

      <div class="hero-enter hero-enter-delay-3 mt-10 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn-primary">
          Work with me
        </a>
        <a href="#content" class="btn-secondary">
          Watch content
        </a>
      </div>
    </div>
  </div>
</section>
