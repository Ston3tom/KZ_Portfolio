---
import { site, withBase } from '../data/site';

const profileSrc = withBase('images/profile_picture.jpg');
---

<section id="home" class="relative min-h-[100svh] overflow-hidden" aria-label="Hero">
  <div class="absolute inset-0 overflow-hidden">
    {/*
      Portrait photos fill wide viewports horizontally, so object-position-x alone
      cannot move the face. Scale + shift creates room to park her on the right.
    */}
    <img
      src={profileSrc}
      alt={`${site.name}, fitness and travel content creator`}
      class="hero-photo hero-image-enter absolute object-cover"
      width="1200"
      height="1600"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="relative flex min-h-[100svh] w-full flex-col justify-end px-5 pb-11 pt-28 sm:px-8 md:pb-14 md:pl-10 lg:pl-16 xl:pl-20">
    <div class="w-full max-w-[13.5rem] text-paper sm:max-w-[15rem] md:max-w-[17rem] lg:max-w-[18.5rem]">
      <p class="hero-enter section-label text-paper/75">
        {site.tagline}
      </p>

      <h1 class="hero-enter hero-enter-delay-1 mt-3 font-display text-[clamp(2.35rem,6.5vw,4.25rem)] font-extrabold leading-[0.95] tracking-[-0.035em]">
        {site.name.split(' ').map((part) => (
          <span class="block">{part}</span>
        ))}
      </h1>

      <div
        class="hero-accent-line mt-4 h-px w-12 bg-pink md:mt-5 md:w-16"
        aria-hidden="true"
      ></div>

      <p class="hero-enter hero-enter-delay-2 mt-4 text-[0.95rem] leading-relaxed text-paper/80 md:mt-5 md:text-base">
        Strength, travel, and lifestyle content from {site.location.split(',')[0]} — authentic training and lived-in storytelling for brand collaborations.
      </p>

      <div class="hero-enter hero-enter-delay-3 mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-8">
        <a href="#contact" class="btn-primary">
          Work with me
        </a>
        <a href="#content" class="btn-secondary">
          Watch content
        </a>
      </div>
    </div>
  </div>
</section>
