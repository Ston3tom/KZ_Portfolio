---
import { focusAreas, site } from '../data/site';
---

<section id="about" class="relative py-24 md:py-32" aria-labelledby="about-title">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20 lg:items-start">
      <div>
        <p class="reveal section-label text-olive">About</p>
        <h2 id="about-title" class="reveal reveal-delay-1 section-title mt-4 text-4xl text-ink md:text-5xl lg:text-[3.25rem]">
          Movement with a point of view
        </h2>
        <div class="reveal reveal-delay-2 mt-7 space-y-5 text-base leading-relaxed text-ink-muted md:text-lg">
          <p>
            I’m {site.name.split(' ')[0]}, a fitness and travel creator based in {site.location}.
            My work sits between serious training and lived-in lifestyle — content that feels strong, clear, and human.
          </p>
          <p>
            Brands partner with me for product storytelling that doesn’t feel staged: apparel, wellness, and beauty pieces that fit naturally into how I train and travel.
          </p>
        </div>
      </div>

      <ul class="reveal reveal-delay-3 space-y-0 border-t border-ink/10 lg:border-t-0 lg:border-l lg:pl-12">
        {
          focusAreas.map((item, i) => (
            <li class={`py-6 ${i < focusAreas.length - 1 ? 'border-b border-ink/10' : ''}`}>
              <div class="flex items-baseline gap-3">
                <span class="font-display text-xs font-bold tracking-[0.15em] text-pink" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="font-display text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
              </div>
              <p class="mt-2 pl-8 text-sm leading-relaxed text-ink-muted md:text-base">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
